rules_version = '2';

// Security model: rooms are shared by an unguessable id. Any signed-in user
// (anonymous auth) who knows a room id may read and edit that room's plan —
// this matches the product's "open link, anyone edits" collaboration model.
// The unguessable id is the only access gate; there is no per-room ACL.
service cloud.firestore {
  match /databases/{database}/documents {
    // Private personal plans: only the matching Google account may read/write.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && collectionName in [
            'vendors',
            'budget',
            'tasks',
            'seserahan',
            'shopping',
            'contacts'
          ];
      }
    }

    match /rooms/{roomId} {
      allow read, write: if request.auth != null;

      // Plan collections. Listed explicitly (not a wildcard) so the broad rule
      // never overlaps the stricter presence rule below — Firestore grants access
      // if ANY matching rule allows it, so an overlap would defeat the presence
      // impersonation guard.
      match /vendors/{docId}   { allow read, write: if request.auth != null; }
      match /budget/{docId}    { allow read, write: if request.auth != null; }
      match /tasks/{docId}     { allow read, write: if request.auth != null; }
      match /seserahan/{docId} { allow read, write: if request.auth != null; }
      match /shopping/{docId}  { allow read, write: if request.auth != null; }
      match /contacts/{docId}  { allow read, write: if request.auth != null; }

      // Presence: anyone in the room can see who's here, but a client may only
      // write its own presence doc (docId == its auth uid) — no impersonation.
      match /presence/{clientId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == clientId;
      }
    }
  }
}
