rules_version = '2';

// Security model
// --------------
// Two kinds of plan space, both holding the same seven collections:
//
//   users/{uid}   private, readable only by the matching Google account
//   rooms/{id}    shared by an unguessable id — anyone signed in who knows the
//                 id may read and edit, matching the product's "open the link,
//                 anyone edits" collaboration model. There is no per-room ACL.
//
// The unguessable id is the room's only gate, so no rule may ever grant `list`
// on /rooms: `read` = `get` + `list`, and a list permission that doesn't depend
// on `resource` would let any anonymous client enumerate every room and defeat
// the gate entirely. Subcollections below a room still need the id to reach, so
// they keep `read` (the client subscribes with a collection query).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidPushToken(data) {
      return data.keys().hasOnly(['token', 'lang', 'currency', 'tzOffsetMin', 'updatedAt'])
        && data.token is string && data.token.size() >= 16 && data.token.size() <= 512
        && data.lang in ['en', 'id']
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8
        && data.tzOffsetMin is int && data.tzOffsetMin >= -840 && data.tzOffsetMin <= 840
        && data.updatedAt is timestamp;
    }

    // ---- Private personal plans -------------------------------------------
    match /users/{uid} {
      // `get`, never `list`: a query over /users can't bind {uid}, so it is
      // denied either way — spelling it out keeps the intent from drifting.
      allow get: if isOwner(uid);
      allow create, update, delete: if isOwner(uid);

      match /{collectionName}/{docId} {
        allow read, write: if isOwner(uid)
          && collectionName in [
            'vendors',
            'budget',
            'tasks',
            'seserahan',
            'shopping',
            'contacts',
            'guests'
          ];
      }

      match /pushTokens/{tokenId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidPushToken(request.resource.data);
      }
    }

    // ---- Link-shared collaborative rooms ----------------------------------
    match /rooms/{roomId} {
      allow get: if signedIn();
      allow create, update, delete: if signedIn();
      // Deliberately absent: `list`. See the header note — it would expose
      // every room to any anonymous client.

      // Plan collections. Listed explicitly rather than as a wildcard so this
      // broad rule never overlaps the stricter presence rule below: Firestore
      // grants access if ANY matching rule allows it, so an overlap would
      // silently defeat the impersonation guard.
      match /vendors/{docId}   { allow read, write: if signedIn(); }
      match /budget/{docId}    { allow read, write: if signedIn(); }
      match /tasks/{docId}     { allow read, write: if signedIn(); }
      match /seserahan/{docId} { allow read, write: if signedIn(); }
      match /shopping/{docId}  { allow read, write: if signedIn(); }
      match /contacts/{docId}  { allow read, write: if signedIn(); }
      match /guests/{docId}    { allow read, write: if signedIn(); }

      // Presence: everyone in the room sees who else is here, but a client may
      // only write the doc named after its own auth uid — no impersonating a
      // collaborator. `clientId` is the uid (RoomStore.tsx:59).
      match /presence/{clientId} {
        allow read: if signedIn();

        // `request.resource.data` is the post-merge document, so the heartbeat's
        // `setDoc(..., { merge: true })` still satisfies `hasOnly` — and the
        // room's presence list can't be repurposed as free storage.
        allow create, update: if isOwner(clientId)
          && request.resource.data.keys().hasOnly(['name', 'color', 'lastSeen'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 64
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 32;

        // Split out from the above: on a delete `request.resource` is null, so
        // the shape check would reject the client's own disconnect cleanup.
        allow delete: if isOwner(clientId);
      }

      // Push tokens: only the owner of `clientId` may read (`get`), create,
      // update, or delete their own push token document. Other room participants
      // must NOT be able to `get` or `list` other members' tokens (the backend
      // Admin SDK reads them server-side).
      match /pushTokens/{clientId} {
        allow get, delete: if isOwner(clientId);
        allow create, update: if isOwner(clientId) && isValidPushToken(request.resource.data);
      }
    }
  }
}
