# Firebase web config for realtime collaboration (optional).
#
# Copy this file to `.env.local` and paste the values from your Firebase project:
#   Firebase console → Project settings → General → Your apps → SDK setup → Config
#
# Leave `.env.local` absent to run the app fully offline (no collaboration UI).
# `.env.local` is gitignored — never commit real credentials.
#
# After filling these in, also (one-time, in the Firebase console):
#   1. Enable Anonymous sign-in:  Authentication → Sign-in method → Anonymous
#   2. Publish the rules in `firestore.rules`

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate (VAPID public key) for Firebase Cloud Messaging:
#   Firebase console → Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Server-only variables for Vercel API / Cron push notifications (set in Vercel project settings):
#   1. Firebase service account JSON string (Project settings → Service accounts → Generate new private key)
#   2. Secret token to authenticate daily Vercel Cron invocations
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
